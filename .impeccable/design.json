  "narrative": {
    "northStar": "The Stems Are the Instrument",
    "overview": "Urdr is a practice room, not a dashboard. The screen is near-black so six coloured lanes can carry the whole song: each stem owns one hue and uses it nowhere else, and a single mint playhead and loop region cut across every lane and the chord lane so the player always sees where they are in all parts at once. White is reserved for the few controls that matter most (play, mute, the sounding chord).",
    "keyCharacteristics": [
      "Near-black ground with two lifted panel tones",
      "One hue per stem, confined to that stem's lane, icon, level and solo state",
      "Mint marks playback and selection, nothing else",
      "White primary controls",
      "A visible key chip beside every control"
    ],
    "rules": [
      {
        "name": "The One Hue Per Stem Rule",
        "body": "A stem's hue appears only on that stem's lane, icon, level slider and solo state. Never reuse it for chrome or state.",
        "section": "colors"
      },
      {
        "name": "The Mint Means Now Rule",
        "body": "Mint is the playhead, the loop region, the active loop button, the tab cursor, sounding notes and the edit selection. If it is not about playback position or selection, it is not mint.",
        "section": "colors"
      },
      {
        "name": "The Key On Screen Rule",
        "body": "Every control shows its key as a chip or names it in its tooltip; a control without a key is unfinished.",
        "section": "typography"
      },
      {
        "name": "The Flat Chrome Rule",
        "body": "Surfaces are separated by tone (ground, panel, raised), not by shadows. The only shadow belongs to floating overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the timeline shared: anything time-based (lanes, chords, loop) uses the same x scale and the same playhead.",
      "Do dim a lane that cannot be heard (muted, or not soloed while another lane is): icon, name, waveform and level together.",
      "Do use tabular numerals for time, speed, pitch and BPM."
    ],
    "donts": [
      "Don't introduce a second accent; state colours beyond mint are limited to failure red.",
      "Don't paint chrome with stem hues.",
      "Don't add shadows to panels or lanes.",
      "Don't use monospace for key chips; O and 0 must stay distinguishable."
    ]
  }
}
